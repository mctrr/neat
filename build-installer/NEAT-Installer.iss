; NEAT Browser Chinese Edition - installer script
; Generated by build-installer/make_iss.py

#define MyAppName "NEAT 浏览器"
#define MyAppVersion "0.16.0"
#define MyAppPublisher "Fallen"
#define MyAppURL "https://github.com/mctrr/neat"
#define MyAppExeName "neat.exe"

[Setup]
AppId={{8F2C4D6E-9A71-4B3C-AE5D-7C1F0B2D6E84}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}/releases
DefaultDirName={autopf}\NEAT
DefaultGroupName={#MyAppName}
AllowNoIcons=yes
LicenseFile=D:\neat-rebuild\LICENSE
OutputDir=D:\neat-rebuild\build-installer\Output
OutputBaseFilename=NEAT-Browser-0.16.0-CN-x64
SetupIconFile=D:\neat-rebuild\browser\branding\official\default.ico
UninstallDisplayIcon={app}\neat.exe
Compression=lzma2/max
SolidCompression=yes
WizardStyle=modern
ArchitecturesInstallIn64BitMode=x64
MinVersion=10.0.17763

[Languages]
Name: "chinesesimplified"; MessagesFile: "compiler:Languages\ChineseSimplified.isl"

[Types]
Name: compact; Description: "紧凑安装（系统内核 + 基础中文规则，推荐）"
Name: full; Description: "完整安装（自带内核 + 全部规则）"
Name: custom; Description: "自定义"; Flags: iscustom

[Components]
Name: core; Description: "NEAT 浏览器核心程序（必需）"; Types: compact full custom; Flags: fixed
Name: runtime; Description: "自带 WebView2 内核（约 510 MB，不勾选则用系统已装的 WebView2）"; Types: full
Name: filters; Description: "广告过滤规则"; Types: compact full custom; Flags: fixed
Name: filters\base; Description: "基础规则（国际通用，约 20 MB）"
Name: filters\base_cn; Description: "基础 + 中文规则（推荐，约 21 MB）"; Types: compact custom
Name: filters\base_privacy; Description: "基础 + 中文 + 隐私规则（约 35 MB）"
Name: filters\all; Description: "全部规则（约 54 MB）"; Types: full

[Files]
Source: "D:\neat-installer-src\app\*"; DestDir: "{app}"; Flags: recursesubdirs ignoreversion; Components: core
Source: "D:\neat-installer-src\neat_adblock.dll"; DestDir: "{app}"; Flags: ignoreversion; Components: core
Source: "D:\neat-installer-src\runtime\WebView2\*"; DestDir: "{app}\WebView2"; Flags: recursesubdirs ignoreversion; Components: runtime

